# ---------------------------------------------------------------------------
# DryRun API configuration. Copy to api/.env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# The production database DryRun protects (your hostel management system).
# Rehearsals only READ it (pg_dump). A real production apply uses this same DSN,
# so the role needs DDL rights only if you want apply_to_production to work.
DRYRUN_PROD_DSN=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hostel
DRYRUN_PROD_NAME=hostel-prod

# A Postgres server where DryRun may CREATE/DROP throwaway sandbox databases.
# Can be the same local server (needs CREATEDB). Sandboxes are named dryrun_sbx_*.
DRYRUN_SANDBOX_ADMIN_DSN=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres

# DryRun's own metadata DB (created automatically if omitted: <sandbox server>/dryrun_meta)
# DRYRUN_META_DSN=postgresql://postgres:YOUR_PASSWORD@localhost:5432/dryrun_meta

# Folder containing pg_dump / pg_restore (auto-detected on PATH or C:\Program Files\PostgreSQL\<v>\bin)
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# --- TrueForge agent harness (npx @truefoundry/trueforge) -------------------
TRUEFORGE_BASE_URL=http://localhost:8790
# TRUEFORGE_TOKEN=            # only if TrueForge login/OIDC is enabled
DRYRUN_AGENT_NAME=dryrun-rehearsal-agent
# Must match a model you enabled in TrueForge → Settings → Models (provider/model), e.g. openai/gpt-5-5
DRYRUN_AGENT_MODEL=openai/gpt-5-5
# Where TrueForge reaches DryRun's MCP server (localhost needs the allow-list, see scripts/start-trueforge.ps1)
DRYRUN_MCP_PUBLIC_URL=http://localhost:8000/mcp/
# Shared secret TrueForge sends as X-DryRun-Agent-Key (pick any long random string)
DRYRUN_MCP_KEY=replace-with-a-long-random-string
# trueforge = the TrueForge agent drives the rehearsal; direct = deterministic engine only (no LLM)
DRYRUN_AGENT_MODE=trueforge
# TrueForge's Daytona code sandbox turns on automatically once a Daytona provider is added in TrueForge
# (Settings → Sandbox providers). Set true to force it on.
DRYRUN_AGENT_SANDBOX=false
# Nightly drift check (TrueForge schedule, Asia/Kolkata)
DRYRUN_DRIFT_CRON=30 2 * * *

# --- AWS: off-site copy of every production backup (credentials via `aws configure`, never in this file) ---
# AWS_S3_BUCKET=dryrun-backups-yourteam
# AWS_REGION=ap-south-1

# --- Optional integrations ----------------------------------------------------
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo
# SLACK_WEBHOOK_URL=

WEB_ORIGIN=http://localhost:3000
